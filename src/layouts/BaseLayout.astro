---
/**
 * Esqueleto HTML común a todas las páginas.
 * <slot /> es donde Astro inserta el contenido de la página que usa este layout.
 */
import { Font } from 'astro:assets';

import SEO from '../components/seo/SEO.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...{ title, description, noindex }} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Se precargan las dos fuentes del primer pintado: mono (texto del hero) y sans (header) -->
    <Font cssVariable="--font-jetbrains" preload />
    <Font cssVariable="--font-schibsted" preload />
    <slot name="head" />
  </head>
  <body>
    <!-- Primer elemento enfocable: salta la cabecera (navegación con teclado) -->
    <a
      href="#contenido"
      class="sr-only z-50 rounded-ui bg-ink px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>
    <div class="site">
      <slot />
    </div>

    <script>
      /**
       * Único IntersectionObserver del sitio. Marca con .is-in los elementos animables
       * cuando entran en pantalla:
       *  - respaldo del revelado [data-reveal] / [data-draw] si no hay animation-timeline;
       *  - disparador de animaciones por tiempo (diagrama, traza de IA, proceso).
       */
      const selector =
        '[data-reveal], [data-reveal-group], [data-draw], [data-diagram], [data-trace], [data-process], [data-flow], [data-arch]';
      const targets = document.querySelectorAll<HTMLElement>(selector);

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
        );
        targets.forEach((target) => observer.observe(target));
      } else {
        targets.forEach((target) => target.classList.add('is-in'));
      }
    </script>
  </body>
</html>
