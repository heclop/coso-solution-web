---
/**
 * Página 404. Astro genera dist/404.html y Cloudflare Pages la sirve automáticamente
 * (con estado 404) para cualquier ruta que no exista. noindex: no debe aparecer en Google.
 */
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Button from '../components/ui/Button.astro';
import LinkArrow from '../components/ui/LinkArrow.astro';
import { mainNav, primaryCta } from '../data/navigation';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | Coso Solution"
  description="La página que buscas no existe o ya no está disponible."
  noindex
>
  <Header />
  <MobileMenu />
  <main id="contenido" class="bg-ink text-white">
    <div class="wrap py-[clamp(72px,12vw,160px)]">
      <p class="font-mono text-[13px] text-code-dim">
        <span class="text-amber">Error 404</span>
      </p>
      <h1 class="mt-6 max-w-[760px] font-mono text-[clamp(32px,5vw,60px)] leading-[1.08] font-bold tracking-[-0.03em]">
        Esta página no está disponible.
      </h1>
      <p class="mt-6 max-w-[520px] text-mist-strong">
        Es posible que el enlace esté mal escrito o que la página se haya movido. Puedes volver al
        inicio o ir a la sección de contacto.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3">
        <Button href="/" size="lg" arrow>
          Volver al inicio
        </Button>
        <LinkArrow href={primaryCta.href} class="text-white">
          {primaryCta.label}
        </LinkArrow>
      </div>
      <nav aria-label="Secciones del sitio" class="mt-14 border-t border-ink-line pt-6">
        <ul class="flex flex-wrap gap-x-8 gap-y-2 font-mono text-sm">
          {mainNav.map((link) => (
            <li>
              <a href={link.href} class="text-mist hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>
