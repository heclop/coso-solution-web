---
/**
 * Hero en dos partes:
 * 1. Portada a todo el ancho: imagen + capa oscura (degradado) + texto encima.
 *    - El degradado es más denso donde está el texto: contraste ≥ 4.5:1 sin importar la foto.
 *    - Movimiento solo con transform: zoom de entrada (CSS), parallax de scroll (CSS
 *      scroll-driven, donde el navegador lo soporta) y un leve seguimiento del puntero (JS,
 *      solo escritorio). Todo se desactiva con prefers-reduced-motion.
 *    - La imagen es el LCP: carga inmediata, prioridad alta y nunca empieza con opacity: 0.
 * 2. Franja "en la práctica" con el diagrama antes/después (HTML real, no imagen).
 */
import { images } from '../../assets/images';
import { hero } from '../../data/home';
import { primaryCta } from '../../data/navigation';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import LinkArrow from '../ui/LinkArrow.astro';
import Photo from '../ui/Photo.astro';
---

<section id="inicio" aria-labelledby="t-hero">
  <!-- ───── Portada ───── -->
  <div class="hero-cover relative isolate overflow-hidden bg-ink text-white" data-hero>
    <!-- Capas de la imagen: parallax (scroll) › puntero › zoom de entrada -->
    <div class="hero-parallax absolute inset-0 -z-20">
      <div class="hero-pointer h-full w-full">
        <Photo
          src={images[hero.image.key]}
          alt={hero.image.alt}
          sizes="100vw"
          priority
          quality={55}
          class="hero-img h-full w-full object-cover object-[62%_50%]"
        />
      </div>
    </div>
    <!-- Capa de transparencia: degradado de marca para garantizar la lectura -->
    <div class="hero-overlay absolute inset-0 -z-10" aria-hidden="true"></div>
    <!-- Retícula técnica (mismo motivo que la sección de IA): se desplaza a otra profundidad con el
         puntero y el scroll; nunca se mueve sola -->
    <div
      class="hero-grid blueprint pointer-events-none absolute -inset-12 z-[-5]"
      aria-hidden="true"
    ></div>

    <div class="wrap flex min-h-[clamp(560px,calc(100svh_-_76px),860px)] flex-col justify-end pt-24 pb-[clamp(40px,6vw,88px)] lg:justify-center">
      <!-- Texto con estilo de código fuente: números de línea + resaltado de sintaxis -->
      <div class="code-hero max-w-[860px] font-mono">
        <h1 id="t-hero">
          <!-- Texto real para lectores de pantalla y buscadores (la versión visual es decorativa) -->
          <span class="sr-only">
            {hero.label}. {hero.titleLead} {hero.titleAccent}
          </span>
          <span class="block" aria-hidden="true" data-typing>
            <span class="code-row text-[clamp(12px,1.1vw,14px)] font-medium tracking-[0.02em]">
              <span class="ln">01</span>
              <span class="text-mist-strong" data-type-line data-speed="11">
                <span class="text-code-dim">// </span>
                {hero.label}
              </span>
            </span>
            <span class="code-row mt-5 text-[clamp(30px,4.2vw,58px)] leading-[1.08] font-bold tracking-[-0.035em]">
              <span class="ln">02</span>
              <span class="text-white [text-wrap:balance]" data-type-line data-speed="30">
                {hero.titleLead}
              </span>
            </span>
            <span class="code-row text-[clamp(30px,4.2vw,58px)] leading-[1.08] font-bold tracking-[-0.035em]">
              <span class="ln">03</span>
              <span class="text-sky [text-wrap:balance]" data-type-line data-speed="30">
                {hero.titleAccent}
              </span>
            </span>
          </span>
        </h1>

        <p class="code-row hero-in mt-7 text-[clamp(14px,1.2vw,16.5px)] leading-[1.7]">
          <span class="ln" aria-hidden="true">
            04
          </span>
          <span class="max-w-[620px] text-mist-strong">
            <span class="text-code-dim" aria-hidden="true">
              /*{' '}
            </span>
            {hero.lead}
            <span class="text-code-dim" aria-hidden="true">
              {' '}
              */
            </span>
          </span>
        </p>

        <div class="code-row hero-in mt-9">
          <span class="ln" aria-hidden="true">
            05
          </span>
          <div class="flex flex-wrap items-center gap-x-7 gap-y-3 font-sans">
            <Button href={primaryCta.href} size="lg" arrow>
              {primaryCta.label}
            </Button>
            <LinkArrow href={hero.secondaryCta.href} class="text-white">
              {hero.secondaryCta.label}
            </LinkArrow>
          </div>
        </div>
        <p class="code-row hero-in mt-6 text-[13px] leading-[1.6] text-mist">
          <span class="ln" aria-hidden="true">
            06
          </span>
          <span class="max-w-[520px]">
            <span class="text-code-dim" aria-hidden="true">
              //{' '}
            </span>
            {hero.note}
          </span>
        </p>
      </div>
    </div>

    <p class="absolute right-[clamp(16px,4vw,48px)] bottom-4 hidden font-mono text-[11px] tracking-[0.04em] text-mist uppercase md:block">
      {hero.image.caption}
    </p>
  </div>

  <!-- ───── En la práctica: diagrama antes / después ───── -->
  <div class="wrap flex flex-wrap items-center gap-[clamp(40px,6vw,88px)] py-[clamp(64px,8vw,112px)]">
    <div class="min-w-0 flex-[1_1_360px]" data-reveal>
      <Eyebrow class="mb-4 text-brand">{hero.practice.eyebrow}</Eyebrow>
      <h2 class="text-[clamp(28px,3vw,40px)] leading-[1.1] font-bold tracking-[-0.02em]">
        {hero.practice.title}
      </h2>
      <p class="mt-5 max-w-[460px] text-body">{hero.practice.text}</p>
    </div>

    <figure
      class="diagram m-0 min-w-0 flex-[1.2_1_440px] rounded-md border border-line bg-[#F5F7FA]"
      data-diagram
    >
      <figcaption class="flex justify-between gap-3 border-b border-line px-5 py-3.5 font-mono text-xs tracking-[0.04em] text-muted uppercase">
        <span>{hero.diagram.caption}</span>
        <span>Ejemplo ilustrativo</span>
      </figcaption>

      <div class="px-5 pt-6 pb-2">
        <p class="mb-3.5 font-mono text-xs tracking-[0.04em] text-muted">ANTES</p>
        <ol class="flex flex-col">
          {hero.diagram.before.map((item, index) => (
            <li class="diagram-step" style={`--s:${index}`}>
              <div class="flex items-center gap-3 rounded-ui border border-line bg-white px-3.5 py-3 text-[15px]">
                <span class="w-[22px] font-mono text-xs text-muted">{item.step}</span>
                {item.text}
              </div>
              {item.handoff && (
                <p class="py-1.5 pl-12 font-mono text-xs text-rust">↓ {item.handoff}</p>
              )}
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-4 border-t border-dashed border-[#B9C4D3] px-5 pt-5 pb-6">
        <p class="mb-3.5 font-mono text-xs tracking-[0.04em] text-brand">DESPUÉS</p>
        <ol
          class="flow relative flex flex-col gap-2 sm:flex-row sm:items-stretch"
          aria-label="Flujo automatizado"
        >
          {hero.diagram.after.map((node, index) => (
            <>
              {index > 0 && (
                <li
                  class="flow-link relative flex-none pl-3.5 font-mono text-[13px] text-brand sm:self-center sm:pl-0"
                  style={`--s:${index}`}
                  aria-hidden="true"
                >
                  <span class="flow-dot max-sm:hidden" />
                  <span class="sm:hidden">↓{index === 1 ? ' API' : ''}</span>
                  <span class="max-sm:hidden">{index === 1 ? '—API→' : '—→'}</span>
                </li>
              )}
              <li
                class="flow-node flex min-w-0 flex-1 items-center rounded-ui bg-ink px-3.5 py-2.5 text-sm leading-snug font-medium text-white"
                style={`--s:${index}`}
              >
                {node}
              </li>
            </>
          ))}
        </ol>
        <p class="mt-3.5 text-sm text-muted">{hero.diagram.afterNote}</p>
      </div>
    </figure>
  </div>
</section>

<style>
  /* ───── Diagrama antes/después (se dispara con .is-in del IntersectionObserver) ─────
     1. Los pasos «antes» entran uno a uno.  2. Aparecen los nodos «después».
     3. Un pulso recorre cada conexión (3 veces, < 5 s: WCAG 2.2.2). */
  .flow-dot {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .flow-dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 0 4px rgb(31 95 224 / 0.18);
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .diagram-step,
    .flow-node,
    .flow-link {
      transition:
        opacity 0.5s var(--ease-out-soft),
        transform 0.5s var(--ease-out-soft);
    }
    .diagram-step {
      transition-delay: calc(var(--s) * 260ms + 150ms);
    }
    .flow-node,
    .flow-link {
      transition-delay: calc(var(--s) * 180ms + 1000ms);
    }
    [data-diagram]:not(.is-in) .diagram-step {
      opacity: 0;
      transform: translateX(-14px);
    }
    [data-diagram]:not(.is-in) :is(.flow-node, .flow-link) {
      opacity: 0;
      transform: translateY(8px);
    }
    [data-diagram].is-in .flow-dot {
      animation: flow-travel 1.3s ease-in-out 3;
      animation-delay: calc(1.7s + (var(--s) - 1) * 0.65s);
    }
  }

  @keyframes flow-travel {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  /* Capa de transparencia.
     Móvil: el texto va abajo → degradado vertical, casi opaco en la parte inferior.
     Escritorio: el texto va a la izquierda → degradado horizontal + viñeta inferior. */
  .hero-overlay {
    background: linear-gradient(
      180deg,
      rgb(11 27 51 / 0.45) 0%,
      rgb(11 27 51 / 0.72) 38%,
      rgb(11 27 51 / 0.94) 72%,
      rgb(11 27 51 / 0.97) 100%
    );
  }
  @media (min-width: 64rem) {
    .hero-overlay {
      background:
        linear-gradient(0deg, rgb(11 27 51 / 0.55) 0%, transparent 35%),
        linear-gradient(
          90deg,
          rgb(11 27 51 / 0.96) 0%,
          rgb(11 27 51 / 0.92) 50%,
          rgb(11 27 51 / 0.62) 72%,
          rgb(11 27 51 / 0.3) 100%
        );
    }
  }

  /* ───── Texto como código fuente ───── */
  .code-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
  }
  .ln {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    color: var(--color-code-dim);
    user-select: none;
  }
  @media (max-width: 40rem) {
    .code-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .ln {
      display: none;
    }
  }

  /* ───── Efecto de escritura ─────
     Solo con JS activo y sin movimiento reducido (media queries, sin script inline que
     la CSP bloquearía). Hasta que el script del componente prepara las letras, la línea se
     oculta desde el primer frame; si el script fallara, una animación de seguridad la
     muestra a los 4 s. Sin JS o con movimiento reducido, el texto se ve completo. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    [data-type-line]:not(.tw-ready) {
      opacity: 0;
      animation: tw-safety 0s 4s forwards;
    }
    /* El resto del texto entra con un fundido corto: los botones son usables desde el inicio */
    .hero-in {
      animation: hero-fade 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
    }
  }
  [data-typing] :global(.tw-word) {
    white-space: nowrap;
  }
  [data-typing] :global(.tw-char:not(.on)) {
    opacity: 0;
  }
  /* Cursor de ancho Y alto 0 apoyado en la línea base: se mueve con el texto sin agrandar
     la línea ni desplazar nada (CLS 0). El palito visible es el ::after, en posición absoluta. */
  [data-typing] :global(.tw-caret) {
    display: inline-block;
    position: relative;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }
  [data-typing] :global(.tw-caret)::after {
    content: '';
    position: absolute;
    left: 0.06em;
    bottom: -0.12em;
    width: max(2px, 0.08em);
    height: 1.05em;
    background: currentColor;
  }
  /* Al terminar parpadea 4 veces (< 5 s, WCAG 2.2.2) y desaparece */
  [data-typing] :global(.tw-caret.idle)::after {
    animation: tw-blink 1s steps(1) 4;
  }

  @keyframes tw-safety {
    to {
      opacity: 1;
    }
  }
  @keyframes tw-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* La imagen sobredimensionada un poco para que el movimiento nunca deje bordes vacíos */
  .hero-parallax {
    inset: -6% 0;
  }
  .hero-pointer {
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .hero-cover :global(.hero-img) {
    transform: scale(1.06);
  }
  /* La retícula se desvanece hacia los bordes y se mueve más que la foto (sensación de profundidad) */
  .hero-grid {
    mask-image: radial-gradient(ellipse 60% 70% at 28% 55%, #000 20%, transparent 75%);
    transform: translate3d(calc(var(--px, 0px) * -1.6), calc(var(--py, 0px) * -1.6), 0);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Zoom de entrada: solo transform (el LCP se pinta desde el primer frame) */
    .hero-cover :global(.hero-img) {
      animation: hero-zoom 2.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* Parallax ligado al scroll (solo ≥ 768 px): la foto baja más despacio que la página
       y la retícula aún más despacio → dos planos de profundidad */
    @media (min-width: 48rem) {
      @supports (animation-timeline: scroll()) {
        .hero-parallax,
        .hero-grid {
          animation: hero-parallax linear both;
        }
        /* animation-timeline/range en regla aparte y más específica: si van junto al shorthand, el
         minificador los fusiona en «animation: … scroll()», forma que Chrome descarta entera. */
        .hero-parallax.hero-parallax,
        .hero-grid.hero-grid {
          animation-timeline: scroll(root);
          animation-range: 0 100svh;
        }
        .hero-grid {
          animation-name: hero-grid-drift;
        }
      }
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.18);
    }
    to {
      transform: scale(1.06);
    }
  }
  @keyframes hero-parallax {
    to {
      transform: translate3d(0, 14%, 0);
    }
  }
  @keyframes hero-grid-drift {
    to {
      translate: 0 22%;
    }
  }
</style>

<script>
  import { keystrokeDelays } from '../../lib/typing';

  /* ───── Efecto de escritura ───── */

  /** Sustituye el texto de la línea por <span> por carácter (agrupados por palabra para que no se partan). */
  function splitIntoChars(line: HTMLElement): HTMLElement[] {
    const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);

    const chars: HTMLElement[] = [];
    // Colapsar espacios también ENTRE nodos de texto, como hace el navegador: si no, «// » + « texto»
    // daría dos espacios visibles, cambiaría el ancho de la línea y movería el diseño (CLS).
    let previousEndedInSpace = true; // el inicio de línea cuenta como espacio
    nodes.forEach((node, index) => {
      let text = (node.textContent ?? '').replace(/\s+/g, ' ');
      if (previousEndedInSpace) text = text.trimStart();
      if (index === nodes.length - 1) text = text.trimEnd();
      if (text !== '') previousEndedInSpace = text.endsWith(' ');

      const fragment = document.createDocumentFragment();
      for (const part of text.split(/( )/)) {
        if (part === '') continue;
        const word = document.createElement('span');
        if (part !== ' ') word.className = 'tw-word';
        for (const char of part) {
          const span = document.createElement('span');
          span.className = 'tw-char';
          span.textContent = char;
          word.append(span);
          chars.push(span);
        }
        fragment.append(word);
      }
      node.replaceWith(fragment);
    });
    return chars;
  }

  const typing = document.querySelector<HTMLElement>('[data-typing]');

  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (typing && motionOk) {
    const caret = document.createElement('span');
    caret.className = 'tw-caret';

    const LINE_PAUSE = 220; // ms antes de empezar cada línea
    const queue: { el: HTMLElement; delay: number }[] = [];

    typing.querySelectorAll<HTMLElement>('[data-type-line]').forEach((line, lineIndex) => {
      const chars = splitIntoChars(line);
      const delays = keystrokeDelays(
        chars.map((c) => c.textContent).join(''),
        Number(line.dataset.speed ?? 40),
      );
      chars.forEach((el, i) => {
        const pause = i === 0 ? (lineIndex === 0 ? 200 : LINE_PAUSE) : 0;
        queue.push({ el, delay: (delays[i] ?? 0) + pause });
      });
      line.classList.add('tw-ready');
    });

    // El cursor empieza al inicio de la primera línea
    const first = queue[0];
    if (first) {
      first.el.before(caret);
      let index = 0;
      const typeNext = () => {
        const item = queue[index];
        if (!item) {
          caret.classList.add('idle');
          caret.addEventListener('animationend', () => caret.remove(), { once: true });
          return;
        }
        item.el.classList.add('on');
        item.el.after(caret);
        index += 1;
        window.setTimeout(typeNext, queue[index]?.delay ?? 0);
      };
      window.setTimeout(typeNext, first.delay);
    }
  }

  /* ───── Leve seguimiento del puntero (solo ratón, solo si no se pidió reducir el movimiento) ───── */
  // Las variables --px/--py se ponen en la portada: las leen la foto y la retícula (distinta profundidad)
  const cover = document.querySelector<HTMLElement>('[data-hero]');
  const allowed = window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)');

  if (cover && allowed.matches) {
    let frame = 0;
    cover.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = cover.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        cover.style.setProperty('--px', `${(-x * 18).toFixed(1)}px`);
        cover.style.setProperty('--py', `${(-y * 12).toFixed(1)}px`);
      });
    });
    cover.addEventListener('pointerleave', () => {
      cover.style.setProperty('--px', '0px');
      cover.style.setProperty('--py', '0px');
    });
  }
</script>
