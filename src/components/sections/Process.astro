---
/** Proceso recomendado en 5 pasos sobre una regla horizontal (vertical en móvil). */
import { images } from '../../assets/images';
import { process } from '../../data/home';
import Photo from '../ui/Photo.astro';
---

<section id="proceso" aria-labelledby="t-proceso" class="py-[clamp(72px,9vw,128px)]">
  <div class="wrap">
    <div class="flex flex-wrap items-end gap-[clamp(32px,5vw,72px)]">
      <div class="min-w-0 flex-[1_1_460px]" data-reveal>
        <h2
          id="t-proceso"
          class="text-[clamp(34px,4vw,56px)] leading-[1.05] font-extrabold tracking-[-0.025em]"
        >
          {process.title}
        </h2>
        <p class="mt-5 max-w-[520px] text-body">{process.intro}</p>
      </div>
      <div class="photo-frame h-[300px] min-w-0 flex-[0_1_380px] overflow-hidden rounded-ui bg-ink">
        <Photo
          src={images.reunion}
          alt={process.imageAlt}
          sizes="(min-width: 768px) 380px, 100vw"
          widths={[380, 480, 760, 960]}
          class="h-full w-full object-cover object-[50%_55%]"
        />
      </div>
    </div>

    <div class="process relative mt-14 border-t-2 border-line" data-process>
      <span
        class="process-bar absolute -top-0.5 left-0 h-0.5 w-full bg-ink"
        aria-hidden="true"
      ></span>
      <ol class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))]">
        {process.steps.map((step, index) => (
          <li class="process-step pt-6 pr-6 pb-2" style={`--s:${index}`}>
            <p class="font-mono text-[13px] text-brand">Paso {index + 1}</p>
            <h3 class="mt-2.5 mb-2 text-xl font-bold">{step.title}</h3>
            <p class="text-base text-body">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Barra de progreso: avanza mientras la sección cruza la pantalla (scroll-driven);
     sin soporte, se completa con una transición cuando la sección entra (.is-in). */
  .process-bar {
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .process-bar {
        animation: process-fill linear both;
      }
      /* animation-timeline/range en regla aparte y más específica: si van junto al shorthand, el
         minificador los fusiona en «animation: … scroll()», forma que Chrome descarta entera. */
      .process-bar.process-bar {
        animation-timeline: view();
        animation-range: entry 40% cover 55%;
      }
    }
    @supports not (animation-timeline: view()) {
      @media (scripting: enabled) {
        .process-bar {
          transition: transform 1.6s var(--ease-out-soft);
        }
        [data-process]:not(.is-in) .process-bar {
          transform: scaleX(0);
        }
      }
    }
  }
  @keyframes process-fill {
    from {
      transform: scaleX(0);
    }
  }
</style>
